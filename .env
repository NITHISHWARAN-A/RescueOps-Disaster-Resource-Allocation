# RescueOps Environment Variables
# ------------------------------------
# Step 1: Paste your Gmail App Password below (no quotes needed)
# Step 2: Save this file
# Step 3: Run: python app.py
#
# How to get Gmail App Password:
#   1. Go to myaccount.google.com
#   2. Security → 2-Step Verification (must be ON)
#   3. App passwords → Mail → Windows Computer → Generate
#   4. Copy the 16-character password and paste below

EMAIL_PASSWORD=oqup mxoy qziy oygh

# Optional: Change the sender email (default is rescueops.support@gmail.com)
# EMAIL_SENDER=rescueops.support@gmail.com
